# Cross-platform Python owns the compiler/link/package commands so flags do not drift.
# Run: make -f Makefile.ps4 [package]; see BUILD.md.
PYTHON ?= python3
ifeq ($(EXPERIMENTAL_USB),1)
MODE := --experimental-usb
else
MODE := --production
endif
SDK_ARG := $(if $(OO_PS4_TOOLCHAIN),--sdk "$(OO_PS4_TOOLCHAIN)",)
all:
	$(PYTHON) tools/build_ps4.py $(MODE) $(SDK_ARG)
package:
	$(PYTHON) tools/build_ps4.py $(MODE) $(SDK_ARG) --package
.PHONY: all package
